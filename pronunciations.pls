<?xml version="1.0" encoding="UTF-8"?>
<!-- ElevenLabs pronunciation dictionary for Money Problems. Alias rules work on every model.
     Narration is written in plain words, so most entries are safety nets for names and
     abbreviations that slip into the text. -->
<lexicon version="1.0"
      xmlns="http://www.w3.org/2005/01/pronunciation-lexicon"
      alphabet="ipa" xml:lang="en-US">
  <lexeme><grapheme>IEEE</grapheme><alias>I triple E</alias></lexeme>
  <lexeme><grapheme>Kahan</grapheme><alias>Kah hahn</alias></lexeme>
  <lexeme><grapheme>COBOL</grapheme><alias>co ball</alias></lexeme>
  <lexeme><grapheme>BigDecimal</grapheme><alias>big decimal</alias></lexeme>
  <lexeme><grapheme>BigInt</grapheme><alias>big int</alias></lexeme>
  <lexeme><grapheme>repr</grapheme><alias>repper</alias></lexeme>
  <lexeme><grapheme>fsum</grapheme><alias>F sum</alias></lexeme>
  <lexeme><grapheme>ulp</grapheme><alias>ulp</alias></lexeme>
  <lexeme><grapheme>NaN</grapheme><alias>nan</alias></lexeme>
  <lexeme><grapheme>JSON</grapheme><alias>jay son</alias></lexeme>
  <lexeme><grapheme>SQL</grapheme><alias>sequel</alias></lexeme>
  <lexeme><grapheme>SQLite</grapheme><alias>S Q lite</alias></lexeme>
  <lexeme><grapheme>CSV</grapheme><alias>C S V</alias></lexeme>
  <lexeme><grapheme>ISO</grapheme><alias>eye so</alias></lexeme>
  <lexeme><grapheme>HashBin</grapheme><alias>hash bin</alias></lexeme>
  <lexeme><grapheme>Pyodide</grapheme><alias>pie oh dide</alias></lexeme>
  <lexeme><grapheme>Initech</grapheme><alias>in ih tek</alias></lexeme>
  <lexeme><grapheme>Dhahran</grapheme><alias>dah rahn</alias></lexeme>
  <lexeme><grapheme>binary64</grapheme><alias>binary sixty-four</alias></lexeme>
  <lexeme><grapheme>IBM</grapheme><alias>I B M</alias></lexeme>
  <lexeme><grapheme>VAX</grapheme><alias>vax</alias></lexeme>
  <!-- SQL type names are written in capitals; say them as ordinary words, not letters. -->
  <lexeme><grapheme>DECIMAL</grapheme><alias>decimal</alias></lexeme>
  <lexeme><grapheme>NUMERIC</grapheme><alias>numeric</alias></lexeme>
  <lexeme><grapheme>FLOAT</grapheme><alias>float</alias></lexeme>
  <lexeme><grapheme>REAL</grapheme><alias>real</alias></lexeme>
  <lexeme><grapheme>DOUBLE</grapheme><alias>double</alias></lexeme>
  <lexeme><grapheme>PRECISION</grapheme><alias>precision</alias></lexeme>
  <lexeme><grapheme>wei</grapheme><alias>way</alias></lexeme>
  <lexeme><grapheme>satoshi</grapheme><alias>sa toe shee</alias></lexeme>
  <lexeme><grapheme>satoshis</grapheme><alias>sa toe shees</alias></lexeme>
</lexicon>
